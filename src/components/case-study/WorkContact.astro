---
import { followDestinations } from "../../data/contactFollow";
---

<p class="eyebrow">LET’S CONNECT</p>
<h2 class="closing-heading">
  Let’s talk systems,
  <br />
  products and production.
</h2>
<p class="closing-deck">
  Open to mobile architecture opportunities, fintech engineering conversations,
  product architecture reviews and selected consulting discussions.
</p>
<div class="closing-grid">
  <div class="conversation-panel">
    <h3 class="eyebrow">START A CONVERSATION</h3>
    <p class="form-note">A short note is enough.</p>
    <form
      name="portfolio-contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="website"
    >
      <input type="hidden" name="form-name" value="portfolio-contact" />
      <div hidden>
        <label>
          Leave this field empty
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="contact-name">Name</label>
          <input
            id="contact-name"
            name="name"
            autocomplete="name"
            required
            maxlength="120"
          />
        </div>
        <div class="form-field">
          <label for="contact-email">Work email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
          />
        </div>
      </div>
      <div class="form-field">
        <label for="contact-discussion">What would you like to discuss?</label>
        <select id="contact-discussion" name="discussion" required>
          <option value="" selected disabled>
            Select a discussion
          </option>
          <option>Mobile architecture opportunity</option>
          <option>Engineering leadership</option>
          <option>App / architecture review</option>
          <option>Consulting</option>
          <option>Other</option>
        </select>
      </div>
      <div class="form-field">
        <label for="contact-message">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          maxlength="6000"
        ></textarea>
      </div>
      <button type="submit" class="send-message">
        Send message <span aria-hidden="true">→</span>
      </button>
    </form>
  </div>
  <aside class="direct-contact" aria-labelledby="direct-contact-heading">
    <h3 id="direct-contact-heading" class="eyebrow">
      DIRECT CONTACT
    </h3>
    <dl class="direct-register">
      <div class="direct-entry">
        <dt>EMAIL</dt>
        <dd>
          <a
            class="direct-action"
            href="mailto:shreyasym4415@gmail.com"
            aria-label="Email Shreyas at shreyasym4415@gmail.com"
          >
            shreyasym4415@gmail.com <span aria-hidden="true">↗</span>
          </a>
        </dd>
      </div>
      <div class="direct-entry">
        <dt>LINKEDIN</dt>
        <dd>
          <a
            class="direct-action"
            href="https://www.linkedin.com/in/shreyas-y-m-34a121215/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View Shreyas Y M’s LinkedIn profile (opens in a new tab)"
          >
            View profile <span aria-hidden="true">↗</span>
          </a>
        </dd>
      </div>
      <div class="direct-entry">
        <dt>RESUME</dt>
        <dd>
          <a
            class="direct-action"
            href="/resume/Shreyas_YM_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open Shreyas Y M’s résumé PDF in a new tab"
          >
            View résumé <span aria-hidden="true">↗</span>
          </a>
        </dd>
      </div>
    </dl>
  </aside>
</div>

<div class="follow-work">
  <h3 class="eyebrow">FOLLOW MY WORK</h3>
  <div class="follow-destinations">
    {followDestinations.map(({ label, href }) =>
      href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">
          {label} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="follow-unconfigured" aria-disabled="true">
          {label} <span aria-hidden="true">↗</span>
        </span>
      ),
    )}
  </div>
</div>

<style>
  :global(#contact) .closing-heading {
    font-size: clamp(38px, 4.5vw, 64px);
  }
  :global(#contact) p.closing-deck {
    max-width: 720px;
    line-height: 1.7;
    margin-top: 24px;
  }
  .closing-grid {
    display: grid;
    grid-template-columns: 560px minmax(0, 1fr);
    gap: 88px;
    margin-top: 44px;
    align-items: start;
  }
  .closing-grid h3,
  .follow-work h3 {
    font-size: 12px;
  }
  .conversation-panel {
    width: 100%;
    max-width: 560px;
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: 18px;
    padding: 30px;
    background: #eeece4;
  }
  :global(#contact) p.form-note {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  form {
    margin-top: 24px;
  }
  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .form-field {
    min-width: 0;
    margin-bottom: 18px;
  }
  .form-field label {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .form-field :is(input, select, textarea) {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 44px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    padding: 10px 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 16px;
    line-height: 1.5;
    box-shadow: none;
  }
  .form-field textarea {
    height: 90px;
    min-height: 90px;
    resize: vertical;
  }
  .form-field select {
    color-scheme: light;
  }
  .form-field :is(input, select, textarea):focus-visible {
    outline: 1px solid var(--teal);
    outline-offset: 4px;
    border-bottom-color: var(--teal);
  }
  .send-message {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 46px;
    border: 0;
    box-shadow: inset 0 0 0 1px var(--color-ink);
    border-radius: 6px;
    padding: 10px 20px;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    transition:
      background-color 250ms ease-out,
      color 250ms ease-out;
  }
  .send-message span {
    transition: transform 250ms ease-out;
    display: inline-block;
  }
  @media (hover: hover) and (pointer: fine) {
    .send-message:hover {
      background-color: var(--color-ink);
      color: var(--color-paper);
    }
    .send-message:hover span {
      transform: translateX(5px);
    }
  }
  .send-message:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-paper);
    outline: 2px solid var(--teal);
    outline-offset: 5px;
  }
  .send-message:focus-visible span {
    transform: translateX(5px);
  }
  .direct-contact {
    min-width: 0;
  }
  .direct-contact h3 {
    margin-bottom: 24px;
  }
  .direct-register {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 0;
    max-width: 420px;
  }
  .direct-entry {
    min-width: 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .direct-entry dt {
    font-size: 12px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .direct-entry dd {
    margin: 10px 0 0;
  }
  .direct-action {
    display: inline-block;
    max-width: 100%;
    min-height: 44px;
    padding: 0 0 18px;
    font-size: 18px;
    line-height: 1.4;
    overflow-wrap: anywhere;
    transition: color 170ms ease-out;
  }
  .direct-action span {
    display: inline-block;
    transition: transform 170ms ease-out;
  }
  .direct-action:hover {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .direct-action:hover span {
    transform: translate(2px, -2px);
  }
  .direct-action:focus-visible,
  .follow-destinations a:focus-visible {
    outline: 3px solid #339f91;
    outline-offset: 5px;
  }
  .direct-unavailable {
    font-size: 17px;
    line-height: 1.4;
    padding: 0 0 20px;
    color: var(--muted);
  }
  .follow-work {
    border-top: 1px solid var(--rule);
    margin-top: 40px;
    padding-top: 22px;
  }
  .follow-destinations {
    display: flex;
    flex-wrap: wrap;
    gap: 96px;
    margin-top: 12px;
  }
  .follow-destinations > :is(a, span) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 17px;
  }
  .follow-destinations a {
    transition: color 170ms ease-out;
  }
  .follow-destinations a span {
    transition: transform 170ms ease-out;
  }
  .follow-destinations a:hover {
    color: var(--teal);
  }
  .follow-destinations a:hover span {
    transform: translate(2px, -2px);
  }
  .follow-unconfigured {
    color: var(--muted);
  }
  :global(.work-closing .footer-bottom) {
    margin-top: 36px;
  }
  @media (max-width: 1099px) {
    .closing-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media (max-width: 700px) {
    .conversation-panel {
      padding: 28px;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .send-message {
      width: 100%;
    }
    .follow-destinations {
      flex-direction: column;
      align-items: start;
      gap: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .send-message span,
    .direct-action,
    .direct-action span,
    .follow-destinations a,
    .follow-destinations a span {
      transition: none;
    }
    .send-message:hover span,
    .direct-action:hover span,
    .follow-destinations a:hover span {
      transform: none;
    }
  }
</style>
