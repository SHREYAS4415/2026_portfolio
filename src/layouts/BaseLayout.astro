---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
interface Props {
  title?: string;
  description?: string;
  useContactRegister?: boolean;
  workClosing?: boolean;
}
const {
  useContactRegister = false,
  workClosing = false,
  title = "Shreyas Y M — Mobile Application Architect",
  description = "Mobile application architecture, fintech systems and production responsibility. Selected work and architectural reasoning by Shreyas Y M.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2eb" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer useContactRegister={useContactRegister} workClosing={workClosing} />
  </body>
</html>
