---
import BaseLayout from "../layouts/BaseLayout.astro";
import Flagship from "../components/home/Flagship.astro";
import ArchitectureStories from "../components/home/ArchitectureStories.astro";
import ArchitecturalLens from "../components/home/ArchitecturalLens.astro";
import { scope, selectedWork, career, leadership } from "../data/portfolio";
---

<BaseLayout useContactRegister>
  <section class="hero wrap">
    <p class="eyebrow hero-reveal">
      PRODUCT JOURNEYS · SYSTEMS THINKING · PRODUCTION
    </p>
    <div class="hero-grid">
      <h1>
        <span class="hero-line hero-reveal">Mobile</span>
        <span class="hero-line hero-reveal">Application</span>
        <em class="hero-line hero-reveal">Architect.</em>
      </h1>
      <div class="hero-copy">
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="hero-reveal">
          I connect complex product journeys with mobile architecture,
          implementation, integration, release and production responsibility.
        </p>
        <small class="hero-reveal">
          Fintech Mobile Systems · Cross-Platform Architecture · Production
          Reliability
        </small>
        <div class="actions hero-reveal">
          <a class="button" href="#work">
            Explore work <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="#contact">
            Get in touch <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-bottom">
      <span>THE PRACTICE</span>
      <span>From product complexity to production responsibility.</span>
      <span aria-hidden="true">↓</span>
    </div>
  </section>
  <section class="scope wrap" aria-label="Professional scope">
    {scope.map((item, index) => (
      <article>
        <span class="index">0{index + 1}</span>
        <h2>{item.title}</h2>
        <p>{item.text}</p>
      </article>
    ))}
  </section>
  <Flagship />
  <section id="architecture" class="section wrap">
    <ArchitecturalLens>
      <div slot="thesis" class="section-heading">
        <p class="eyebrow">03 / THE ARCHITECTURAL LENS</p>
        <h2>
          Product surface.
          <br />
          <em>System depth.</em>
        </h2>
      </div>
    </ArchitecturalLens>
  </section>
  <ArchitectureStories />
  <section id="ai" class="ai-systems wrap section">
    <div class="section-heading ai-header" data-ai-stagger>
      <p class="eyebrow">05 / AI & AGENTIC SYSTEMS</p>
      <h2>
        Another system.
        <br />
        The same discipline.
      </h2>
      <p>
        Applying application-architecture and production-engineering discipline
        to retrieval, orchestration, agent workflows and AI product systems.
      </p>
      <p class="ai-proof-line">
        Multi-Agent Systems · Multi-RAG Document Intelligence · Multimodal
        Agentic AI
      </p>
    </div>

    <div class="ai-controls" role="tablist" data-ai-stagger>
      <button
        role="tab"
        aria-selected="true"
        aria-controls="ai-view-1"
        id="ai-tab-1"
      >
        01 · Systems Atlas
      </button>
      <button
        role="tab"
        aria-selected="false"
        aria-controls="ai-view-2"
        id="ai-tab-2"
      >
        02 · Evidence Ladder
      </button>
      <button
        role="tab"
        aria-selected="false"
        aria-controls="ai-view-3"
        id="ai-tab-3"
      >
        03 · Architecture Orbit
      </button>
    </div>

    <div class="ai-views">
      <!-- VIEW 01: SYSTEMS ATLAS -->
      <div
        id="ai-view-1"
        role="tabpanel"
        aria-labelledby="ai-tab-1"
        class="ai-view active"
      >
        <div class="ai-systems-atlas">
          <article class="ai-system-column">
            <div class="ai-system-number index">01</div>
            <div class="ai-system-status status-live">
              ● LIVE / COLLABORATIVE
            </div>
            <h3>
              Multi-Agent
              <br />
              System
            </h3>
            <p>
              Worked collaboratively on a live multi-agent system using
              specialized agents, orchestration/routing, shared state, tool
              execution and consolidated outputs for startup workflows.
            </p>
            <div class="ai-system-tech">
              ORCHESTRATION · ROUTING · SHARED STATE · TOOLS · AGENT
              COORDINATION
            </div>
          </article>

          <article class="ai-system-column">
            <div class="ai-system-number index">02</div>
            <div class="ai-system-status status-live">
              ● LIVE / COLLABORATIVE
            </div>
            <h3>
              Multi-RAG
              <br />
              Document Intelligence
            </h3>
            <p>
              Worked collaboratively on an in-app document intelligence system
              where user documents are processed, embedded, retrieved through
              vector search and RAG, assembled into grounded context, and
              analyzed through LLMs to provide contextual answers inside the
              application.
            </p>
            <div class="ai-system-tech">
              DOCUMENTS · EMBEDDINGS · VECTOR SEARCH · RAG · GROUNDED CONTEXT ·
              LLMS
            </div>
          </article>

          <article class="ai-system-column">
            <div class="ai-system-number index">03</div>
            <div class="ai-system-status status-dev">
              ● CAPSTONE / IN DEVELOPMENT
            </div>
            <h3>
              Multimodal
              <br />
              Agentic AI
            </h3>
            <p>
              Building an Azure-based multimodal compliance system around
              multimodal ingestion, Azure Video Indexer, Azure AI Search RAG,
              Azure OpenAI, LangGraph orchestration, structured outputs, API
              integration and observability.
            </p>
            <div class="ai-system-tech">
              AZURE VIDEO INDEXER · AI SEARCH · AZURE OPENAI · LANGGRAPH ·
              OBSERVABILITY
            </div>
          </article>
        </div>
      </div>

      <!-- VIEW 02: EVIDENCE LADDER -->
      <div
        id="ai-view-2"
        role="tabpanel"
        aria-labelledby="ai-tab-2"
        class="ai-view"
      >
        <div class="ai-ladder">
          <div class="ai-ladder-line"></div>

          <article class="ai-ladder-item left">
            <div class="ai-ladder-node"></div>
            <div class="ai-ladder-content">
              <div class="ai-ladder-header">
                <span class="index">01</span>
                <span class="ai-system-status status-live">
                  ● LIVE / COLLABORATIVE
                </span>
              </div>
              <h3>Multi-Agent System</h3>
              <p>
                Worked collaboratively on a live multi-agent system using
                specialized agents, orchestration/routing, shared state, tool
                execution and consolidated outputs for startup workflows.
              </p>
              <div class="ai-system-tech">
                ORCHESTRATION · ROUTING · SHARED STATE · TOOLS · AGENT
                COORDINATION
              </div>
            </div>
          </article>

          <article class="ai-ladder-item right">
            <div class="ai-ladder-node"></div>
            <div class="ai-ladder-content">
              <div class="ai-ladder-header">
                <span class="index">02</span>
                <span class="ai-system-status status-live">
                  ● LIVE / COLLABORATIVE
                </span>
              </div>
              <h3>Multi-RAG Document Intelligence</h3>
              <p>
                Worked collaboratively on an in-app document intelligence system
                where user documents are processed, embedded, retrieved through
                vector search and RAG, assembled into grounded context, and
                analyzed through LLMs to provide contextual answers inside the
                application.
              </p>
              <div class="ai-system-tech">
                DOCUMENTS · EMBEDDINGS · VECTOR SEARCH · RAG · GROUNDED CONTEXT
                · LLMS
              </div>
            </div>
          </article>

          <article class="ai-ladder-item left">
            <div class="ai-ladder-node"></div>
            <div class="ai-ladder-content">
              <div class="ai-ladder-header">
                <span class="index">03</span>
                <span class="ai-system-status status-dev">
                  ● CAPSTONE / IN DEVELOPMENT
                </span>
              </div>
              <h3>Multimodal Agentic AI</h3>
              <p>
                Building an Azure-based multimodal compliance system around
                multimodal ingestion, Azure Video Indexer, Azure AI Search RAG,
                Azure OpenAI, LangGraph orchestration, structured outputs, API
                integration and observability.
              </p>
              <div class="ai-system-tech">
                AZURE VIDEO INDEXER · AI SEARCH · AZURE OPENAI · LANGGRAPH ·
                OBSERVABILITY
              </div>
            </div>
          </article>

          <div class="ai-ladder-footer">
            <span>APPLICATION</span>
            <span aria-hidden="true">→</span>
            <span>RETRIEVAL</span>
            <span aria-hidden="true">→</span>
            <span>ORCHESTRATION</span>
            <span aria-hidden="true">→</span>
            <span>AGENTS</span>
          </div>
        </div>
      </div>

      <!-- VIEW 03: ARCHITECTURE ORBIT -->
      <div
        id="ai-view-3"
        role="tabpanel"
        aria-labelledby="ai-tab-3"
        class="ai-view"
      >
        <div class="ai-orbit dark">
          <header class="ai-orbit-header" data-orbit-step="0">
            <div class="ai-orbit-header-left">
              <span class="eyebrow">05 / AI & AGENTIC SYSTEMS</span>
              <h2>
                Different systems.
                <br />
                <span class="accent-teal">Shared concerns.</span>
              </h2>
            </div>
            <div class="ai-orbit-header-right">
              <p>
                One visual model showing how the three AI proof points connect
                back to the same architectural core.
              </p>
            </div>
          </header>

          <div class="ai-orbit-diagram">
            <svg class="ai-orbit-svg" preserveAspectRatio="xMidYMid slice">
              <line
                class="orbit-line"
                data-orbit-step="2"
                x1="50%"
                y1="50%"
                x2="20%"
                y2="20%"
              />
              <line
                class="orbit-line"
                data-orbit-step="2"
                x1="50%"
                y1="50%"
                x2="80%"
                y2="20%"
              />
              <line
                class="orbit-line"
                data-orbit-step="2"
                x1="50%"
                y1="50%"
                x2="50%"
                y2="85%"
              />
            </svg>

            <div class="ai-orbit-core-wrapper" data-orbit-step="1">
              <div class="ai-orbit-core-ring"></div>
              <button
                type="button"
                class="ai-orbit-core"
                aria-label="Highlight connected AI systems"
              >
                <span class="eyebrow">ARCHITECTURAL CORE</span>
                <h3>
                  Application
                  <br />
                  Systems
                </h3>
                <p>State · boundaries · failure handling · delivery</p>
              </button>
            </div>

            <article
              class="ai-orbit-node node-1"
              data-orbit-step="3"
              id="orbit-node-1"
            >
              <div class="ai-orbit-node-header">
                <span class="index">01</span>
                <span class="status-live">LIVE</span>
              </div>
              <h3>
                Multi-Agent
                <br />
                System
              </h3>
              <p class="ai-system-tech">
                Routing · shared state · tools · coordination
              </p>
            </article>

            <article
              class="ai-orbit-node node-2"
              data-orbit-step="3"
              id="orbit-node-2"
            >
              <div class="ai-orbit-node-header">
                <span class="index">02</span>
                <span class="status-live">LIVE</span>
              </div>
              <h3>
                Multi-RAG Document
                <br />
                Intelligence
              </h3>
              <p class="ai-system-tech">
                Embeddings · vector search · grounded context
              </p>
            </article>

            <article
              class="ai-orbit-node node-3"
              data-orbit-step="3"
              id="orbit-node-3"
            >
              <div class="ai-orbit-node-header">
                <span class="index">03</span>
                <span class="status-dev">CAPSTONE</span>
              </div>
              <h3>
                Multimodal
                <br />
                Agentic AI
              </h3>
              <p class="ai-system-tech">
                Video · RAG · LangGraph · observability
              </p>
            </article>
          </div>

          <div class="ai-orbit-concerns" data-orbit-step="4">
            <span>EVALUATION</span>
            <span>OBSERVABILITY</span>
            <span>FAILURE HANDLING</span>
            <span>LATENCY / COST</span>
          </div>
        </div>
      </div>
    </div>

    <div class="ai-ownership" data-ai-stagger>
      <div class="ai-ownership-content">
        <span class="eyebrow">OWNERSHIP / PRODUCTION</span>
        <p>“I independently built and operate the production system.”</p>
      </div>
    </div>

    <div class="systems-lens" data-ai-stagger>
      <span class="eyebrow">SYSTEMS LENS</span>
      <div class="systems-lens-notation">
        <ol class="systems-lens-flow">
          <li>Application</li>
          <li aria-hidden="true">→</li>
          <li>Orchestration</li>
          <li aria-hidden="true">→</li>
          <li>Retrieval / Tools</li>
          <li aria-hidden="true">→</li>
          <li>Context / State</li>
          <li aria-hidden="true">→</li>
          <li>Models / Agents</li>
          <li aria-hidden="true">→</li>
          <li>Result</li>
        </ol>
        <div class="systems-lens-support">
          Evaluation · Observability · Failure Handling · Latency / Cost
        </div>
      </div>
    </div>
  </section>
  <section id="about" class="wrap section work-career">
    <div>
      <p class="eyebrow">06 / OTHER WORK</p>
      <h2>Across product contexts.</h2>
      <ol class="other-work">
        {selectedWork.map((item, index) => (
          <li>
            <span class="index">0{index + 1}</span>
            <h3>{item}</h3>
            <span aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>
      <p class="muted">
        Selected professional product domains. Individual case studies and
        evidence to follow.
      </p>
    </div>
    <aside>
      <p class="eyebrow">CAREER / LEADERSHIP</p>
      {career.map((company) => (
        <h3 class="career-name">{company}</h3>
      ))}
      <p>{leadership}</p>
    </aside>
  </section>
</BaseLayout>

<script>
  let cleanupAiMotion = () => {};

  const initAiMotion = () => {
    cleanupAiMotion();
    const aiSection = document.querySelector<HTMLElement>(".ai-systems");
    if (!aiSection) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reducedMotion) {
      aiSection.classList.add("is-revealed");
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          aiSection.classList.add("is-revealed");
          observer.disconnect();
        }
      },
      { rootMargin: "0px 0px -15% 0px" },
    );

    observer.observe(aiSection);

    cleanupAiMotion = () => {
      observer.disconnect();
    };
  };

  initAiMotion();
  document.addEventListener("astro:page-load", initAiMotion);
</script>

<script>
  let cleanupAiTabs = () => {};

  const initAiTabs = () => {
    cleanupAiTabs();
    const tablist = document.querySelector(".ai-controls");
    if (!tablist) return;
    const tabs = Array.from(
      tablist.querySelectorAll<HTMLElement>('button[role="tab"]'),
    );
    const views = Array.from(
      document.querySelectorAll<HTMLElement>(".ai-view"),
    );

    // Ensure default state on bfcache/astro navigation
    tabs.forEach((t, i) => {
      if (i === 0) {
        t.setAttribute("aria-selected", "true");
      } else {
        t.setAttribute("aria-selected", "false");
      }
    });
    views.forEach((v, i) => {
      if (i === 0) {
        v.classList.add("active");
        v.removeAttribute("hidden");
      } else {
        v.classList.remove("active");
        v.setAttribute("hidden", "");
      }
    });

    const selectTab = (selectedTab: HTMLElement) => {
      if (selectedTab.getAttribute("aria-selected") === "true") return;
      const targetId = selectedTab.getAttribute("aria-controls");

      tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
      selectedTab.setAttribute("aria-selected", "true");

      const currentView = views.find((v) => v.classList.contains("active"));
      const nextView = views.find((v) => v.id === targetId);

      if (currentView) {
        currentView.classList.remove("active");
        setTimeout(() => {
          if (!currentView.classList.contains("active")) {
            currentView.setAttribute("hidden", "");
          }
        }, 150);
      }

      if (nextView) {
        nextView.removeAttribute("hidden");
        // trigger reflow
        void (nextView as HTMLElement).offsetWidth;
        nextView.classList.add("active");

        // Handle Orbit Animation replay
        if (targetId === "ai-view-3") {
          const orbit = nextView.querySelector(".ai-orbit");
          if (orbit) {
            orbit.classList.remove("is-animated", "is-idle");
            void (orbit as HTMLElement).offsetWidth; // reflow
            orbit.classList.add("is-animated");
            // Add is-idle after animation completes so hover delays are removed
            setTimeout(() => {
              if (orbit.classList.contains("is-animated")) {
                orbit.classList.add("is-idle");
              }
            }, 1800);
          }
        }
      }
    };

    const listeners = new Map();

    tabs.forEach((t) => {
      const fn = () => selectTab(t);
      t.addEventListener("click", fn);
      listeners.set(t, fn);
    });

    // Orbit Hover effects
    const orbitNodes = Array.from(
      document.querySelectorAll<HTMLElement>(".ai-orbit-node"),
    );
    const orbitLines = Array.from(
      document.querySelectorAll<HTMLElement>(".orbit-line"),
    );

    orbitNodes.forEach((node, idx) => {
      const handleEnter = () => {
        if (orbitLines[idx]) orbitLines[idx].classList.add("is-hovered");
      };
      const handleLeave = () => {
        if (orbitLines[idx]) orbitLines[idx].classList.remove("is-hovered");
      };
      node.addEventListener("mouseenter", handleEnter);
      node.addEventListener("mouseleave", handleLeave);
      listeners.set(node as HTMLElement, { handleEnter, handleLeave } as any);
    });

    // Core Guided Sequence
    const coreBtn = document.querySelector<HTMLElement>(".ai-orbit-core");
    const orbitContainer = document.querySelector<HTMLElement>(".ai-orbit");
    const clearSequence = () => {
      if (orbitContainer) {
        orbitContainer.classList.remove(
          "is-sequence-running",
          "is-all-connected",
        );
      }
      orbitNodes.forEach((n) => n.classList.remove("is-guided-active"));
      orbitLines.forEach((l) => l.classList.remove("is-guided-active"));
    };

    const runGuidedSequence = () => {
      if (!orbitContainer) return;

      // If completed (all 3 active), second click toggles it off
      if (orbitContainer.classList.contains("is-all-connected")) {
        clearSequence();
        return;
      }

      orbitContainer.classList.add("is-sequence-running", "is-all-connected");
      orbitNodes.forEach((n) => n.classList.add("is-guided-active"));
      orbitLines.forEach((l) => l.classList.add("is-guided-active"));
    };

    if (coreBtn) {
      coreBtn.addEventListener("click", runGuidedSequence);
      listeners.set(coreBtn, { handleClick: runGuidedSequence } as any);
    }

    cleanupAiTabs = () => {
      clearSequence();
      tabs.forEach((t) => {
        if (listeners.has(t))
          t.removeEventListener("click", listeners.get(t) as EventListener);
      });
      orbitNodes.forEach((node) => {
        if (listeners.has(node as HTMLElement)) {
          const { handleEnter, handleLeave } = listeners.get(
            node as HTMLElement,
          ) as any;
          node.removeEventListener("mouseenter", handleEnter);
          node.removeEventListener("mouseleave", handleLeave);
        }
      });
      if (coreBtn && listeners.has(coreBtn)) {
        const { handleClick } = listeners.get(coreBtn) as any;
        coreBtn.removeEventListener("click", handleClick);
      }
    };
  };

  initAiTabs();
  document.addEventListener("astro:page-load", initAiTabs);
</script>

<script>
  let cleanupOtherWorkMotion = () => {};

  const initOtherWorkMotion = () => {
    cleanupOtherWorkMotion();

    const container = document.querySelector<HTMLElement>(".other-work");
    if (!container) return;

    const rows = Array.from(container.querySelectorAll<HTMLElement>("li"));
    if (!rows.length) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reducedMotion) {
      container.classList.add("motion-reduced");
    }

    container.classList.add("is-scroll-linked");

    let frame = 0;
    let nearViewport = false;

    const update = () => {
      frame = 0;

      if (!nearViewport) {
        rows.forEach((row) => row.classList.remove("is-active"));
        return;
      }

      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      const thresholdTop = viewportHeight * 0.75;
      const thresholdBottom = viewportHeight * 0.25;

      const totalDistance = rect.height + (thresholdTop - thresholdBottom);
      const scrolled = thresholdTop - rect.top;

      let activeIndex = -1;

      // Only assign an active row if genuinely inside the interaction zone
      if (scrolled >= 0 && scrolled <= totalDistance) {
        const progress = Math.max(0, Math.min(1, scrolled / totalDistance));

        if (progress < 0.33) {
          activeIndex = 0;
        } else if (progress < 0.66) {
          activeIndex = 1;
        } else {
          activeIndex = 2;
        }
      }

      rows.forEach((row, idx) => {
        if (idx === activeIndex) {
          row.classList.add("is-active");
        } else {
          row.classList.remove("is-active");
        }
      });
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    const syncListeners = () => {
      if (nearViewport) {
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule);
      } else {
        window.removeEventListener("scroll", schedule);
        window.removeEventListener("resize", schedule);
      }
      update();
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        nearViewport = entry.isIntersecting;
        syncListeners();
      },
      { rootMargin: "25% 0px 25% 0px" },
    );

    observer.observe(container);

    cleanupOtherWorkMotion = () => {
      observer.disconnect();
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
      if (frame) window.cancelAnimationFrame(frame);
    };
  };

  initOtherWorkMotion();
  document.addEventListener("astro:page-load", initOtherWorkMotion);
</script>
