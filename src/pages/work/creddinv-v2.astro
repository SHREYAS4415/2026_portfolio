---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AssetSlot from "../../components/ui/AssetSlot.astro";
import Metrics from "../../components/ui/Metrics.astro";
import SystemContext from "../../components/figures/SystemContext.astro";
import {
  decisions,
  journeys,
  journeyCapabilities,
  contribution,
  designLevels,
  chapters,
} from "../../data/creddinv";
import { leadership, stories } from "../../data/portfolio";

const productionStages = [
  {
    number: "01",
    label: "APPLICATION LAYER",
    title: "Revamp product architecture",
    detail:
      "Onboarding, session continuity, KYC orchestration, discovery, payments, portfolio and application-state architecture.",
    support: "Product journeys · BLoC/state · integrations",
  },
  {
    number: "02",
    label: "PRODUCTION PLATFORM",
    title: "Retained platform identity + services",
    detail:
      "Android and iOS production identity, native configuration, Firebase services, notifications and third-party production setup.",
    support: "Android · iOS · Firebase · push",
  },
  {
    number: "03",
    label: "RELEASE ENGINEERING",
    title: "Release candidate → live product",
    detail:
      "Versioning, build validation, store preparation, production configuration and rollout into the existing Play Store and App Store product.",
    support: "Versioning · validation · stores · rollout",
  },
];

const releaseReadiness = [
  {
    number: "01",
    label: "STORE + VERSIONING",
    title: "Google Play + App Store",
    detail:
      "Production versioning, build numbers, release preparation and continuity with the existing store applications.",
  },
  {
    number: "02",
    label: "PLATFORM IDENTITY",
    title: "Android + iOS configuration",
    detail:
      "Application identity, native configuration, signing-related production responsibilities and platform continuity.",
  },
  {
    number: "03",
    label: "PRODUCTION SERVICES + RUNTIME CONTROL",
    title: "Firebase · Notifications · Backend-managed banners",
    detail:
      "Production services include Firebase configuration, push notifications and backend-managed banner configuration, allowing selected campaign and communication surfaces to change without requiring a new mobile release.",
  },
  {
    number: "04",
    label: "DISTRIBUTION + REFERRALS",
    title: "Deep links into acquisition journeys",
    detail:
      "Campaign and referral links connect external touchpoints with the appropriate Android or iOS destination and the relevant in-app signup journey.",
    support: "Referral → app/store → signup context",
  },
  {
    number: "05",
    label: "PRODUCTION INTEGRATIONS",
    title: "Payments + external SDKs",
    detail:
      "Payment, authentication, deep-link and other third-party integrations require production configuration beyond feature implementation.",
  },
  {
    number: "06",
    label: "RELEASE WORKFLOW",
    title: "Build → validate → release",
    detail:
      "Release-candidate validation, environment checks and store delivery form the final operational layer before production rollout.",
    support: "Automation shown only where verified",
  },
];

const failureRequestPath = [
  { title: "UI", subtitle: "Presentation" },
  { title: "BLoC", subtitle: "Feature state" },
  { title: "Use Case", subtitle: "Business action" },
  { title: "Repository", subtitle: "Domain contract" },
  { title: "NetworkGuard", subtitle: "Failure boundary", accent: true },
  { title: "Remote Data Source", subtitle: "Transport execution" },
  { title: "API", subtitle: "External system" },
];

const successPath = [
  { title: "API response", subtitle: "Valid data" },
  { title: "Repository result", subtitle: "Domain value" },
  { title: "BLoC state", subtitle: "Success state" },
  { title: "UI", subtitle: "Render content" },
];

const failureMapping = [
  {
    title: "Existing Failure",
    detail: "Preserve the original Failure instance and meaning.",
  },
  { title: "DioException", detail: "Translate through FailureMapper." },
  { title: "Unexpected exception", detail: "Fallback to UnknownFailure." },
];

const productSurface = [
  "Registration",
  "Profile",
  "Identity / KYC",
  "Discovery",
  "Subscription Payment",
  "Commitment",
  "Portfolio",
];

const systemDepth = [
  "Session / lifecycle",
  "Domain modelling",
  "Identity orchestration",
  "State management",
  "Integration boundaries",
  "Failure handling",
  "Payment orchestration",
  "Production lifecycle",
];
---

<BaseLayout
  workClosing
  title="Creddinv v2.0 — Shreyas Y M"
  description="A collaborative fintech mobile product, examined through product journeys, architecture decisions and production responsibility."
>
  <section class="case-opening wrap">
    <a class="back-link" href="/#work">
      ← Selected work
    </a>
    <div class="section-top">
      <p class="eyebrow">CASE STUDY / FINTECH MOBILE SYSTEMS</p>
      <span class="status">
        <i aria-hidden="true"></i> PRODUCTION
      </span>
    </div>
    <h1>
      Creddinv v2.0<span>Product to production.</span>
    </h1>
    <p class="case-deck">
      Product complexity, architectural reasoning
      <br />
      and the responsibility of shipping.
    </p>
    <AssetSlot
      name="creddinv-device-group"
      label="Creddinv product visual"
      alt="Creddinv v2.0 product interface showing portfolio, live campaigns and wealth experiences."
      large
    />
    <Metrics />
  </section>
  <nav class="chapter-nav wrap" aria-label="Case study chapters">
    {chapters.map((chapter, index) => (
      <a href={`#${chapter.id}`}>
        <span>0{index + 1}</span>
        {chapter.title}
      </a>
    ))}
  </nav>
  <section id="scope" class="section wrap chapter">
    <div>
      <p class="eyebrow">01 / PRODUCT COMPLEXITY</p>
      <h2>
        One product.
        <br />
        Many responsibilities.
      </h2>
    </div>
    <div>
      <p class="lead">
        A fintech application spans identity, discovery, participation, payment
        and portfolio visibility.
      </p>
      <p>
        The scope includes differentiated onboarding, resumable signup, multiple
        KYC journeys and multiple payment paths. Each introduces boundaries
        between product intent, application state, services and providers.
      </p>
      <p>
        Production delivery also carries native/platform identity, configuration
        and release responsibilities. Exact service contracts and confidential
        implementation details are intentionally excluded; unverified mechanics
        are labelled as evidence pending.
      </p>
    </div>
  </section>
  <section id="journey" class="section wrap">
    <div class="section-heading journey-intro">
      <p class="eyebrow">02 / PRODUCT JOURNEY</p>
      <h2>
        Journeys through
        <br />
        the product.
      </h2>
      <p>
        These bands describe product areas, not one mandatory uninterrupted
        path. The journey adapts across access, investor identity, verification,
        participation, payment and post-commitment states.
      </p>
    </div>
    <div class="journey-register">
      {journeys.map((band, index) => (
        <article class="product-journey">
          <div class="product-journey-title">
            <span class="journey-number">0{index + 1}</span>
            <h3>{band.title}</h3>
          </div>
          <p class="journey-surface">{band.surface}</p>
          <p class="journey-copy">{band.copy}</p>
          <p class="journey-highlight">{band.highlight}</p>
        </article>
      ))}
    </div>
    <div class="journey-capabilities">
      <h3>CROSS-CUTTING PRODUCT CAPABILITIES</h3>
      <ul>
        {journeyCapabilities.map((capability) => (
          <li>{capability}</li>
        ))}
      </ul>
    </div>
  </section>
  <section id="context" class="dark section">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">03 / SYSTEM CONTEXT + BOUNDARIES</p>
        <h2>
          Clear boundaries.
          <br />
          Explicit responsibility.
        </h2>
        <p>
          A sanitized view of the system's responsibility domains. Exact
          relationships require technical evidence.
        </p>
      </div>
      <SystemContext />
    </div>
  </section>
  <section id="decisions" class="section wrap">
    <div class="section-heading">
      <p class="eyebrow">04 / KEY ARCHITECTURE DECISIONS</p>
      <h2>
        The decisions
        <br />
        that shape the system.
      </h2>
      <p>
        Conservative decision records based on the supplied architecture
        concepts. Detailed implementation evidence remains to be attached.
      </p>
    </div>
    <div class="decisions">
      {decisions.map((record, index) => (
        <article id={record.id}>
          <div class="record-heading">
            <span class="index">ADR / 0{index + 1}</span>
            <h3>{record.title}</h3>
          </div>
          <dl>
            {(
              [
                "constraint",
                "decision",
                "why",
                "tradeoff",
                "consequence",
                "evidence",
              ] as const
            ).map((key) => (
              <div>
                <dt>{key === "consequence" ? "System consequence" : key}</dt>
                <dd>{record[key]}</dd>
              </div>
            ))}
          </dl>
          {record.id === "identity" && (
            <div class="identity-notes">
              <p class="eyebrow">DIFFERENTIATED JOURNEYS</p>
              <p>Indian · NRI · International</p>
              <p class="eyebrow">PROVIDER / VALIDATION CONCEPTS</p>
              <p>DigiLocker · PAN validation · Didit</p>
              <small>
                Exact mapping is evidence pending. Provider return is not
                automatically authoritative.
              </small>
            </div>
          )}
          {record.id === "failure" && (
            <section
              class="failure-architecture"
              aria-labelledby="failure-architecture-title"
            >
              <header class="failure-intro">
                <p class="eyebrow">FAILURE ARCHITECTURE / RUNTIME BEHAVIOR</p>
                <h3 id="failure-architecture-title">
                  One request path.
                  <br />
                  Two explicit outcomes.
                </h3>
                <p>
                  The request crosses the same application boundaries every
                  time. Those boundaries unfold first. Only when the response
                  returns does the visual separate the normal success path from
                  explicit failure handling.
                </p>
              </header>

              <div class="failure-request">
                <p class="failure-step-label">01 / SHARED REQUEST PATH</p>
                <ol class="request-path">
                  {failureRequestPath.map((step, stepIndex) => (
                    <li class:list={[{ accent: step.accent }]}>
                      <div class="request-box">
                        <strong>{step.title}</strong>
                        <span>{step.subtitle}</span>
                      </div>
                      {stepIndex < failureRequestPath.length - 1 && (
                        <span class="request-arrow" aria-hidden="true">
                          →
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>

              <div class="response-divider">
                <span></span>
                <p>
                  Response returns<small>SUCCESS / FAILURE</small>
                </p>
                <span></span>
              </div>

              <div class="response-paths">
                <section class="success-path">
                  <p class="failure-step-label">02A / SUCCESS</p>
                  <h4>Typed data returns.</h4>
                  <ol>
                    {successPath.map((step, stepIndex) => (
                      <li>
                        <div>
                          <strong>{step.title}</strong>
                          <span>{step.subtitle}</span>
                        </div>
                        {stepIndex < successPath.length - 1 && (
                          <span aria-hidden="true">→</span>
                        )}
                      </li>
                    ))}
                  </ol>
                  <p class="response-copy">
                    Successful data returns through the normal application
                    contract. No extra visual machinery is introduced because
                    this is the expected path.
                  </p>
                </section>

                <section class="failure-path">
                  <p class="failure-step-label">02B / FAILURE</p>
                  <h4>Failure meaning is preserved.</h4>
                  <p class="failure-lead">
                    Exception / Failure → explicit failure-handling boundary
                  </p>
                  <div class="failure-mechanisms">
                    <article>
                      <p>
                        NETWORKGUARD <span>Boundary</span>
                      </p>
                      <p>
                        Preserves known Failure instances and separates
                        technical exception handling from feature logic.
                      </p>
                    </article>
                    <span aria-hidden="true">→</span>
                    <article>
                      <p>
                        FAILUREMAPPER <span>Translation</span>
                      </p>
                      <p>
                        Maps Dio / HTTP transport conditions only when
                        translation is required.
                      </p>
                    </article>
                  </div>
                  <p class="failure-result">
                    <span>Result:</span> Either&lt;Failure, T&gt; → BLoC →
                    feature-aware UI presentation.
                  </p>
                </section>
              </div>

              <section class="failure-register">
                <p class="failure-step-label">03 / FAILURE MAPPING</p>
                <div>
                  {failureMapping.map((item) => (
                    <article>
                      <h4>{item.title}</h4>
                      <p>{item.detail}</p>
                    </article>
                  ))}
                </div>
              </section>

              <section class="presentation-policy">
                <p class="failure-step-label">04 / PRESENTATION POLICY</p>
                <div>
                  <article>
                    <h4>Connectivity / timeout</h4>
                    <p>
                      Offline, network and timeout failures resolve to the
                      approved connectivity and retry experience where
                      applicable.
                    </p>
                  </article>
                  <article>
                    <h4>Business / domain failure</h4>
                    <p>
                      Feature-specific meaning remains available to BLoC/UI for
                      the appropriate inline, transient or feature-specific
                      treatment.
                    </p>
                  </article>
                </div>
              </section>

              <p class="failure-note">
                NetworkGuard and FailureMapper establish a consistent Failure
                result; the feature layer remains responsible for deciding how
                that result appears to the user.
              </p>
            </section>
          )}
        </article>
      ))}
    </div>
  </section>
  <section id="depth" class="section wrap">
    <div class="section-heading">
      <p class="eyebrow">05 / PRODUCT SURFACE → SYSTEM DEPTH</p>
      <h2>
        What the user sees.
        <br />
        What the system carries.
      </h2>
    </div>
    <figure class="depth-figure case-depth-figure">
      <div>
        <p class="eyebrow">PRODUCT SURFACE</p>
        <ul class="moment-list">
          {productSurface.map((item, index) => (
            <li>
              <span>{item}</span>
              {index < productSurface.length - 1 && (
                <span class="moment-arrow" aria-hidden="true">
                  →
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="depth-divider">
        <span aria-hidden="true">↓</span>
        <p>Visible product flow above. Shared system responsibility below.</p>
      </div>
      <div>
        <p class="eyebrow">SYSTEM DEPTH</p>
        <ul class="concern-list">
          {systemDepth.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <figcaption>
        These concerns span product moments; this is not a one-to-one mapping.
      </figcaption>
    </figure>
  </section>
  <section id="migration" class="dark section">
    <div class="wrap">
      <div class="section-heading production-heading">
        <p class="eyebrow">06 / PRODUCTION DELIVERY + RELEASE ENGINEERING</p>
        <h2>
          A revamp crosses
          <br />a production boundary.
        </h2>
        <p>
          The new application layer had to meet an existing production identity,
          platform configuration and release surface before Creddinv v2.0 could
          become the next live version of the product.
        </p>
      </div>
      <div class="production-flow" aria-label="Production delivery flow">
        {productionStages.map((stage, index) => (
          <article class="production-stage">
            <p class="production-label">
              {stage.number} / {stage.label}
            </p>
            <h3>{stage.title}</h3>
            <p class="production-detail">{stage.detail}</p>
            <p class="production-support">{stage.support}</p>
            {index < productionStages.length - 1 && (
              <span class="production-arrow" aria-hidden="true">
                →
              </span>
            )}
          </article>
        ))}
      </div>
      <div class="readiness-heading">
        <div>
          <p class="eyebrow">RELEASE READINESS REGISTER</p>
          <h3>What had to remain production-ready.</h3>
        </div>
        <p>Creddinv v2.0 → live production</p>
      </div>
      <div class="release-register">
        {releaseReadiness.map((item) => (
          <article>
            <p class="release-label">
              {item.number} / {item.label}
            </p>
            <h4>{item.title}</h4>
            <p class="release-detail">{item.detail}</p>
            {item.support && <p class="release-support">{item.support}</p>}
          </article>
        ))}
      </div>
      <div class="production-evidence">
        <p>
          This chapter represents production responsibilities at system level.
          Exact deployment automation and provider-specific release mechanics
          are shown only where implementation evidence is verified.
        </p>
        <span>Architecture → release → production</span>
      </div>
    </div>
  </section>
  <section id="contribution" class="section wrap">
    <p class="eyebrow">07 / CONTRIBUTION + EVIDENCE</p>
    <h2>
      Architectural direction.
      <br />
      Collaborative delivery.
    </h2>
    <p class="contribution-statement">
      I owned architectural direction and technical review while leading the
      engineering effort that carried the product into production.
    </p>
    <p>
      The product was delivered collaboratively; architecture ownership does not
      imply sole implementation.
    </p>
    <ul class="contribution-list">
      {contribution.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <div class="design-levels">
      {designLevels.map((level) => (
        <article>
          <p class="eyebrow">{level.title}</p>
          <h3>{level.subtitle}</h3>
          <ul>
            {level.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="leadership">
      <h3>Leadership across professional work</h3>
      <p>{leadership}</p>
    </div>
    <p class="muted">
      Evidence status: contribution statements supplied for this portfolio.
      Sanitized HLD/LLD excerpts, review records and release artifacts are
      pending.
    </p>
  </section>
  <section id="outcomes" class="section wrap">
    <div class="section-heading">
      <p class="eyebrow">08 / OUTCOMES + LIMITATIONS</p>
      <h2>
        What changed
        <br />
        after the revamp.
      </h2>
    </div>
    <div class="outcome-evidence">
      <div class="outcome-primary-row">
        <div class="outcome-group">
          <h3 class="eyebrow">POST-REVAMP OUTCOMES</h3>
          <dl class="outcome-metrics revamp-metrics">
            <div>
              <dt class="teal-metric">
                <span class="teal-cue" aria-hidden="true"></span>
                <span class="metric-value" id="top-metric-val">
                  0%+
                </span>
              </dt>
              <dd>
                <span class="reveal-line">Investor conversion reached</span>
                <small class="reveal-line">
                  Observed after the revamp, alongside fewer reported onboarding
                  drop-offs.
                </small>
              </dd>
            </div>
            <div>
              <dt class="teal-metric">
                <span class="teal-cue" aria-hidden="true"></span>
                <span class="clip-mask">
                  <span class="clip-text">~2–3 min</span>
                </span>
              </dt>
              <dd>
                <span class="reveal-line">Signup completion time</span>
                <small class="reveal-line">Previously ~6 min</small>
              </dd>
            </div>
          </dl>
        </div>
        <div class="outcome-group delivery-group">
          <h3 class="eyebrow">DELIVERY</h3>
          <p class="delivery-name">Creddinv v2.0</p>
          <p class="delivery-status">Live in production</p>
        </div>
      </div>
      <div class="outcome-group">
        <h3 class="eyebrow">MARKET + PRODUCT EXPANSION</h3>
        <div class="expansion-grid">
          <article class="editorial-item">
            <h4>International onboarding</h4>
            <p>
              “Expanded investor journeys across Indian, NRI and International
              profiles instead of a single domestic onboarding path.”
            </p>
            <span class="highlight">Indian → NRI → International</span>
          </article>
          <article class="editorial-item">
            <h4>International KYC</h4>
            <p>
              “International identity verification became part of the mobile
              journey through differentiated verification paths, including
              Didit-backed flows.”
            </p>
            <span class="highlight">Differentiated verification</span>
          </article>
          <article class="editorial-item">
            <h4>International payments</h4>
            <p>
              “Eligible international investors can move through supported
              payment journeys directly from the application.”
            </p>
            <span class="highlight">Cross-border product support</span>
          </article>
        </div>
      </div>
      <div class="outcome-group">
        <h3 class="eyebrow">OPERATIONAL PRODUCT CONTROL</h3>
        <div class="operational-grid">
          <article class="editorial-item">
            <h4>Backend-managed app communication</h4>
            <p>
              “Banner and campaign messaging can be updated from backend-managed
              configuration, reducing the need for a mobile release for every
              content change.”
            </p>
          </article>
          <article class="editorial-item">
            <h4>Backend-driven payment experience</h4>
            <p>
              “Supported payment presentation, relevant messaging and available
              paths can respond to backend-provided state instead of being
              entirely hard-coded in the client.”
            </p>
          </article>
        </div>
      </div>
      <div class="outcome-group full-width-group scale-group">
        <h3 class="eyebrow">04 / PRODUCT SCALE</h3>
        <dl class="outcome-metrics scale-metrics">
          <div class="scale-metric-item scale-item-1">
            <dt
              class="metric-value"
              data-metric-target="35"
              data-metric-format="installs"
            >
              0K+
            </dt>
            <dd>Combined Android + iOS installs</dd>
          </div>
          <div class="scale-metric-item scale-item-2">
            <dt
              class="metric-value"
              data-metric-target="4"
              data-metric-format="mau"
            >
              ~0K
            </dt>
            <dd>Combined monthly active users</dd>
          </div>
          <div class="scale-metric-item scale-item-3">
            <dt
              class="metric-value"
              data-metric-target="4.5"
              data-metric-format="rating"
            >
              0.0★+
            </dt>
            <dd>Google Play rating</dd>
          </div>
        </dl>
      </div>
    </div>
    <aside
      class="outcome-limitations"
      aria-label="Evidence limitations and attribution"
    >
      <p>
        Post-revamp metrics describe observed product-level outcomes and should
        not be interpreted as outcomes attributable solely to individual
        contribution. International expansion and operational-control items
        describe product capabilities delivered as part of the revamp.
      </p>
    </aside>
  </section>
  <section class="case-close wrap section">
    <p class="eyebrow">09 / ARCHITECTURAL LESSON</p>
    <h2>
      Mobile architecture connects product complexity to production
      responsibility.
    </h2>
    <div class="story-links">
      {stories.map((story) => (
        <a href={`#${story.id}`}>
          {story.title}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import {
    clamp,
    staggeredProgress,
    setupMetricGroup,
    tickScaleGroup,
  } from "../../scripts/motion";

  let cleanupCaseStudyMotion = () => {};

  const initializeCaseStudyMotion = () => {
    cleanupCaseStudyMotion();

    const depth = document.querySelector<HTMLElement>(".case-depth-figure");
    const failure = document.querySelector<HTMLElement>(
      ".failure-architecture",
    );
    const production = document.querySelector<HTMLElement>("#migration");

    // Shared upper case study metrics
    const upperMetricsEl = document.querySelector<HTMLElement>(
      ".case-opening .metrics",
    );
    const upperGroup = setupMetricGroup(upperMetricsEl, true);

    // Outcomes animation nodes
    const outcomesTop = document.querySelector<HTMLElement>(
      ".outcome-primary-row",
    );
    const topMetricEl = outcomesTop
      ? outcomesTop.querySelector<HTMLElement>("#top-metric-val")
      : null;

    // Outcomes scale
    const outcomesScale = document.querySelector<HTMLElement>(".scale-group");
    const lowerGroup = setupMetricGroup(outcomesScale, false);

    if (
      !depth &&
      !failure &&
      !production &&
      !outcomesTop &&
      !outcomesScale &&
      !upperMetricsEl
    )
      return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const surfaceItems = depth
      ? [...depth.querySelectorAll<HTMLElement>(".moment-list li")]
      : [];
    const depthItems = depth
      ? [...depth.querySelectorAll<HTMLElement>(".concern-list li")]
      : [];

    if (reducedMotion) {
      depth?.classList.add("motion-reduced");
      failure?.classList.add("motion-reduced", "is-visible");
      production?.classList.add("motion-reduced", "is-visible");
      outcomesTop?.classList.add("motion-reduced", "is-visible");
      outcomesScale?.classList.add("motion-reduced", "is-visible");
      upperMetricsEl?.classList.add("motion-reduced", "is-visible");

      if (topMetricEl) topMetricEl.textContent = "73%+";
      if (lowerGroup)
        lowerGroup.values.forEach((m) => {
          if (m.el) m.el.textContent = m.format(m.val);
        });
      if (upperGroup)
        upperGroup.values.forEach((m) => {
          if (m.el) m.el.textContent = m.format(m.val);
        });
      return;
    }

    depth?.classList.add("is-scroll-linked");
    failure?.classList.add("is-animated");
    production?.classList.add("is-animated");
    outcomesTop?.classList.add("is-animated");
    outcomesScale?.classList.add("is-animated");
    upperMetricsEl?.classList.add("is-animated");

    if (upperMetricsEl)
      upperMetricsEl.setAttribute("data-animate-metrics", "true");

    let frame = 0;
    let topAnimStart = 0;
    let topAnimating = false;

    const update = (now?: number) => {
      frame = 0;
      const viewportHeight = window.innerHeight;
      const nowMs = now || performance.now();
      let needsNextFrame = false;

      if (depth) {
        const rect = depth.getBoundingClientRect();
        const progress = clamp(
          (viewportHeight * 0.82 - rect.top) /
            (rect.height + viewportHeight * 0.52),
        );
        depth.style.setProperty("--depth-progress", progress.toFixed(4));
        depth.style.setProperty(
          "--handoff-progress",
          clamp((progress - 0.25) / 0.15).toFixed(4),
        );
        surfaceItems.forEach((item, index) => {
          item.style.setProperty(
            "--item-progress",
            staggeredProgress(
              progress,
              0,
              0.25,
              index,
              surfaceItems.length,
            ).toFixed(4),
          );
        });
        depthItems.forEach((item, index) => {
          item.style.setProperty(
            "--item-progress",
            staggeredProgress(
              progress,
              0.4,
              0.8,
              index,
              depthItems.length,
            ).toFixed(4),
          );
        });
      }

      if (failure) {
        const rect = failure.getBoundingClientRect();
        const entersViewport =
          rect.top <= viewportHeight * 0.84 && rect.bottom >= 0;
        const userIsClearlyAbove = rect.top > viewportHeight * 0.96;

        if (entersViewport && !failure.classList.contains("is-visible")) {
          failure.classList.add("is-visible");
        } else if (
          userIsClearlyAbove &&
          failure.classList.contains("is-visible")
        ) {
          failure.classList.remove("is-visible");
        }
      }

      if (production) {
        const rect = production.getBoundingClientRect();
        const entersViewport =
          rect.top <= viewportHeight * 0.84 && rect.bottom >= 0;
        const userIsSafelyAbove = rect.top > viewportHeight * 1.08;

        if (entersViewport && !production.classList.contains("is-visible")) {
          production.classList.add("is-visible");
        } else if (
          userIsSafelyAbove &&
          production.classList.contains("is-visible")
        ) {
          production.classList.remove("is-visible");
        }
      }

      if (outcomesTop) {
        const rect = outcomesTop.getBoundingClientRect();
        const entersViewport =
          rect.top <= viewportHeight * 0.84 && rect.bottom >= 0;
        const userIsSafelyAbove = rect.top > viewportHeight * 0.96;

        if (entersViewport && !outcomesTop.classList.contains("is-visible")) {
          outcomesTop.classList.add("is-visible");
          topAnimStart = nowMs;
          topAnimating = true;
          needsNextFrame = true;
        } else if (
          userIsSafelyAbove &&
          outcomesTop.classList.contains("is-visible")
        ) {
          outcomesTop.classList.remove("is-visible");
          topAnimating = false;
          if (topMetricEl) topMetricEl.textContent = "0%+";
        }

        if (topAnimating) {
          const elapsed = nowMs - topAnimStart - 150;
          if (elapsed > 0) {
            const progress = clamp(elapsed / 800);
            const ease = 1 - Math.pow(1 - progress, 3);
            if (topMetricEl)
              topMetricEl.textContent = Math.round(ease * 73) + "%+";

            if (progress < 1) needsNextFrame = true;
            else {
              topAnimating = false;
              if (topMetricEl) topMetricEl.textContent = "73%+";
            }
          } else {
            needsNextFrame = true;
          }
        }
      }

      if (tickScaleGroup(upperGroup, viewportHeight, nowMs))
        needsNextFrame = true;
      if (tickScaleGroup(lowerGroup, viewportHeight, nowMs))
        needsNextFrame = true;

      if (needsNextFrame) {
        requestUpdate();
      }
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    update();

    cleanupCaseStudyMotion = () => {
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", requestUpdate);
      if (frame) window.cancelAnimationFrame(frame);
    };
  };

  initializeCaseStudyMotion();
  document.addEventListener("astro:page-load", initializeCaseStudyMotion);
</script>

